# URL exata deste deployment (sem barra final)
APP_URL=http://localhost:3000
# Origem HTTPS da TeraCode/TeraApps Identity (hospedagem Netlify)
TERACODE_AUTH_URL=https://SEU-PROJETO.netlify.app
TERACODE_CLIENT_ID=tera-imoveis
# Gere com: openssl rand -hex 32 (não publique)
SESSION_SECRET=
# Banco exclusivo dos dados imobiliários (apenas servidor)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# IDs "sub" verificados pela TeraCode que podem administrar toda a plataforma.
# Nunca conceda acesso Master com base apenas em e-mail ou parâmetro na URL.
TERA_MASTER_SUBS=
