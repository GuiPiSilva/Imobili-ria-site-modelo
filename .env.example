# Domínio público principal do site imobiliário (deve bater EXATAMENTE com a URL de callback autorizada)
APP_URL=https://imobiliaria-site-modelo.vercel.app

# TeraApps Identity / Tera ID — Firebase Auth (projeto Netlify já existente)
TERAAPPS_AUTH_URL=https://teraaps.vercel.app
TERAAPPS_CLIENT_ID=tera_imoveis_web

# SEGREDO DA SESSÃO: valor aleatório, min. 32 caracteres. Configure na Vercel, NÃO no GitHub.
# Gere no terminal com: openssl rand -hex 32
SESSION_SECRET=

# Banco dedicado à imobiliária no Supabase (não é o banco Firebase da Tera ID)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# UID(s) de administradores Master do Firebase Authentication da TeraApps,
# separados por vírgula. Não use e-mail nem o ID de outro provedor.
TERA_MASTER_SUBS=
